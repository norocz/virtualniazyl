{block azylContent}
<main class="main" id="top">
    <div class="bg">
        <div class="content">
            <div class = >



            <div class="row">
                <div class="col-xl-6 col-md-12  flex-column">
                    <h3>Sbírky</h3>
                    <div class="collection" id="collection">

                        {foreach $collections as $colecction}

                            <div class="card collection-card text-dark bg-light" style="width: 550px">
                                <img class="card-img-top" src="{$basepath}.{$collection->getHeadline()}" alt="Card image cap">
                                <div class="card-img-overlay">
                                    <h3 class="card-title">{$colection->getCollectionName()}</h3>
                                </div>
                                <div class="card-body">
                                    <p class="card-text"> {$colection->getCollectionDescription()|noescape}</p>

                                    <a href="{link Admin:collection, $collection->getCollectionKey()}" class="btn btn-outline-info btn-sm">Editovat sbírku</a>
                                    <a href="{link Admin:collection !stopColollection, $collection->getCollectionKey()}" class="btn btn-outline-warning btn-sm">Zastavit sbírku</a>

                                </div>
                                <div class="card-footer">
                                    {var $url = link Home:collection, $collection->getCollectionKey()}
                                    Sdílet:
                                    <a href="https://www.facebook.com/sharer/sharer.php?u={$url}" target="_blank" class="btn btn-link text-decoration-none">
                                            <i class="bi bi-facebook"></i> Facebook
                                    </a>

                                    {* Odkaz na sdílení na Instagram *}
                                    <a href="https://www.instagram.com/?url={$url}" target="_blank" class="btn btn-link text-decoration-none">
                                            <i class="bi bi-instagram"></i> Instagram
                                    </a>

                                    {* Odkaz na sdílení na X (Twitter) *}
                                    <a href="https://twitter.com/intent/tweet?url={$url}" target="_blank" class="btn btn-link text-decoration-none">
                                            <i class="bi bi-twitter-x"></i> X
                                    </a>

                                    {* Odkaz na sdílení na LinkedIn *}
                                    <a href="https://www.linkedin.com/shareArticle?url={$url}" target="_blank" class="btn btn-link text-decoration-none">
                                        <i class="bi bi-linkedin"></i> LinkedIn
                                    </a>

                                </div>

                            </div>
                        {/foreach}

                    </div>
                </div>
            </div>
        </div>
        {/block}
{block scripts}
{/block}