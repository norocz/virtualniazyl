{block content}
<main class="main" id="top">
    <div class="bg">
        <div class="content">
            <div class="row g-12 g-lg-6 g-xl-7 pt-6">
                <div class ="col-lg-4">
                   {ifset $kytka}
                    <div> <img  class="img-fluid rounded-1" src="{$basePath}/assets/vazdata/img/pic/{$kytka}" alt="Happy dino"></div>
                    {/ifset}
                </div>

                <div class="col-lg-8">
                    <div class="page" id="page">
                        {ifset $content}
                        <div n:if ="$content" class="content">{$content|noescape}</div>
                        {/ifset}
                    </div>
                </div>
            </div>
        </div>

{/block}
{block scripts-user}
{/block}