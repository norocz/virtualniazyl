{block content}
<style>
    .adoptions-card {

        margin: 1rem;

    }
    .azyl-name { background-color: #9da9bb}

    .bg-adopce-1 {
        background: linear-gradient(to right, #f8cdd6, #f48aa2);
        color: #1a1a1a;
    }

    .bg-adopce-2 {
        background: linear-gradient(to right, #d4eaff, #74a9ff);
        color: #1a1a1a;
    }

    .bg-adopce-3 {
        background: linear-gradient(to right, #c8f7c5, #5fb760);
        color: #1a1a1a;
    }

    .bg-adopce-4 {
        background: linear-gradient(to right, #fff2cc, #f1c40f);
        color: #1a1a1a;
    }

</style>

<main class="main" id="top">
    <div class="bg">
        <div class="content">
            <div class="row">
                <div class="col-xl-12 col-sm-12 flex-column">

                    <div class="row">
                    <div class="h3 col-1 m-2">Adopce</div>

                        <div class="col-10 m-2">

                            <form n:name=searchForm class="form-inline position-relative w-lg-50 ms-lg-4 ms-xl-9 mt-3 mt-lg-0">
                                <div class="input-group mb-3" >
                                    <input n:name=search type="text" class="form-control search fs-8 bg-transparent form-control shadow" placeholder="{$placeholders}" aria-label="Recipient's username" aria-describedby="button-addon2">
                                    <input n:name=send class="btn btn-outline-secondary button shadow" type="submit" value="Hledat" id="button-addon2">
                                </div>

                            </form>
                        </div>
                        {ifset $words}
                        <div class="col-4 m-2">


                                Filtr:&nbsp;
                                {foreach $words as $word}
                                    {if $iterator->last}
                                        <span>{$word}</span>
                                        {else}
                                        <span>{$word}</span>,&nbsp;
                                    {/if}

                                {/foreach}

                        </div>
                        {/ifset}
                        <div class="adoptions d-flex flex-row flex-wrap" id="adoptions">
                            {foreach $adoptions as $adoption}
                                <div class="adoptions-border">
                                    <div class = "card adoptions-card" style="width: 23rem;">
                                        {if !is_null($adoption->getPhotos()[0])}
                                            <img class="card-img-top" src="{$basePath}{$adoption->getPhotos()[0]->getPath().$adoption->getPhotos()[0]->getName()}" alt="{$adoption->getPhotos()[0]->getName()}" />
                                        {else}
                                            <img class="card-img-top" src="{$basePath}/assets/vazdata/img/pic/love1.jpeg" alt="Happy dino" />
                                        {/if}
                                        <h5 class="card-header">{$adoption->getName()}</h5>
                                        <div class="card-body">
                                            <div class="
                                                {switch $adoption->getAdoptionType()}
                                                {case 'Virtuální adopce'} bg-adopce-1
                                                {case 'Dočasná péče'} bg-adopce-2
                                                {case 'Předadopce'} bg-adopce-3
                                                {case 'Plná adopce'} bg-adopce-4
                                                {default} bg-default
                                                {/switch}
                                                large p-1 border-2 bold rounded-1">

                                                {$adoption->getAdoptionType()}



                                            </div>
                                            {if !is_null($adoption->getBirthdate())}
                                                {var $now = new DateTimeImmutable()}
                                                {var $interval = date_diff($vek = $adoption->getBirthdate(), $now)}

                                                <h5 class="card-title">Plemeno: {$adoption->getBreed()} Věk: {$interval->y} </h5>
                                            {else}
                                                <h5 class="card-title">Plemeno: {$adoption->getBreed()}</h5>
                                            {/if}
                                            {if !is_null($adoption->getHeight())}
                                            Výška: {$adoption->getHeight()} cm <br>
                                            {/if}
                                            {if !is_null($adoption->getWeight())}
                                                Hmotnost: {$adoption->getWeight()} Kg <br>
                                            {/if}
                                            <hr>
                                            <p class="card-text">{$adoption->getDescription()}</p>

                                            {if $user->isLoggedIn()}
                                                <a href="{link Home:adopce $adoption->getId()}" class="btn btn-sm btn-outline-primary">Chci adoptovat!</a>
                                            {else}
                                                <a href="{link Home:SignIn}" class="btn btn-sm btn-outline-primary">Přihlašení</a>
                                            {/if}
                                            <a href="{link Home:azyl $adoption->getAzyl()->getId()}" class="btn btn-sm btn-outline-info">{$adoption->getAzyl()->getAzylName()}</a>
                                        </div>
                                    </div>
                                </div>
                            {/foreach}


                    </div>
                </div>
            </div>
        </div>
        {/block}
{block scripts-user}
{/block}