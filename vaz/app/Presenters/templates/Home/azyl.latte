{block content}
<style>
    .sidebar
    {
     padding: 0.5rem;
     margin-top: 1em;
     margin-bottom: 1em;
     background-color: #dddddddd;
     border-radius: 5px;
     border: #0d6efd;
    }

     .news-card {
         margin-bottom: 2rem;
     }

     .sidenav a:hover {
         background-color: #eeeeee;
     }

    .adoptions-card {

        margin: 1rem;
        margin-top: 0rem;
    }

    .bg-adopce-1 {
        background: linear-gradient(to right, #f8cdd6, #f48aa2);
        color: #1a1a1a;
    }

    .bg-adopce-2 {
        background: linear-gradient(to right, #d4eaff, #74a9ff);
        color: #1a1a1a;
    }

    .bg-adopce-3 {
        background: linear-gradient(to right, #c8f7c5, #5fb760);
        color: #1a1a1a;
    }

    .bg-adopce-4 {
        background: linear-gradient(to right, #fff2cc, #f1c40f);
        color: #1a1a1a;
    }

</style>

<div class="container">
    <div class="row">
        <h2>{$azylProfil->getAzylName()}</h2>
        <div class="col-md-12 col-xl-3 info ">
            <div class="sidebar shadow">
                <div class="sidebar-container">
                    <div class="sidebar-header">

                    </div>
                    <div class="sidebar-nav">
                        <div class="sidenav">
                            <a n:class="sidebar-item, $presenter->isLinkCurrent('Home:azyl') ? 'active'" n:href ="Home:azyl $presenter->getParameter('id')">
                                   <div class="sidebar-item-content">
                                       <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-postcard-heart" viewBox="0 0 16 16">
                                           <path d="M8 4.5a.5.5 0 0 0-1 0v7a.5.5 0 0 0 1 0zm3.5.878c1.482-1.42 4.795 1.392 0 4.622-4.795-3.23-1.482-6.043 0-4.622M2.5 5a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1zm0 2a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1zm0 2a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1z"/>
                                           <path fill-rule="evenodd" d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1z"/>
                                       </svg>
                                    <span>Profil azylu</span>

                                </div>
                            </a>
                            <a n:class="sidebar-item, $presenter->isLinkCurrent('Home:azyladoptions') ? 'active'" n:href ="Home:azyladoptions  $presenter->getParameter('id')">
                                <div class="sidebar-item-content">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-house-heart" viewBox="0 0 16 16">
                                        <path d="M8 6.982C9.664 5.309 13.825 8.236 8 12 2.175 8.236 6.336 5.309 8 6.982"/>
                                        <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.707L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.646a.5.5 0 0 0 .708-.707L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5z"/>
                                    </svg>
                                    <span>Všechny adopce azylu</span>
                                </div>
                            </a>
                            <a n:class="sidebar-item, $presenter->isLinkCurrent('Home:azylnews') ? 'active'" n:href ="Home:azylnews $presenter->getParameter('id')">
                                <div class="sidebar-item-content">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar2-fill" viewBox="0 0 16 16">
                                        <path d="M4 .5a.5.5 0 0 0-1 0V1H2a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-1V.5a.5.5 0 0 0-1 0V1H4zM2.545 3h10.91c.3 0 .545.224.545.5v1c0 .276-.244.5-.546.5H2.545C2.245 5 2 4.776 2 4.5v-1c0-.276.244-.5.545-.5"/>
                                    </svg>
                                    <span>Aktuality azylu</span>
                                </div>
                            </a>
                            <a n:class="sidebar-item, $presenter->isLinkCurrent('Home:azylphotos') ? 'active'" n:href ="Home:azylphotos $presenter->getParameter('id')">
                                <div class="sidebar-item-content">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-camera" viewBox="0 0 16 16">
                                        <path d="M15 12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h1.172a3 3 0 0 0 2.12-.879l.83-.828A1 1 0 0 1 6.827 3h2.344a1 1 0 0 1 .707.293l.828.828A3 3 0 0 0 12.828 5H14a1 1 0 0 1 1 1zM2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.172a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 9.172 2H6.828a2 2 0 0 0-1.414.586l-.828.828A2 2 0 0 1 3.172 4z"/>
                                        <path d="M8 11a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5m0 1a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7M3 6.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0"/>
                                    </svg>
                                    <span>Fotky azylu</span>
                                </div>
                            </a>
                        </div>
                        <hr>

                        <div class="photo sidebar">
                            {if $azylPhoto !== null}
                                <img src="{$basePath}{$azylPhoto->getPath().$azylPhoto->getName()}" alt="{$azylProfil->getAzylName()}" class="img-fluid">
                            {else}
                                <img src="{$basePath}/assets/vazdata/img/pic/defaultPhoto.jpeg" alt="{$azylProfil->getAzylName()}" class="img-fluid">
                            {/if}
                        </div>
                        {snippet message}
                        {if $user->isLoggedIn()}



                        <div class="send p-1 border-xl-2">
                        <form class="ajax" n:name=azylSendMessageForm>
                            <label for="message" class="form-label">Vzakaz azylu</label>
                            <textarea rows="5" aria-label="Poslat vzkaz"  class="ajax form-control btn-outline-info m-1" n:name=message>

                            </textarea>

                            <input class="ajax btn btn-success m-1" id="button-addon2" n:name=send type="submit" value="Poslat vzkaz">
                            <input n:name=address type="hidden" value="{$conversation}">


                        </form>
                        {ifset $messageReturn}
                        {$messageReturn}
                        {/ifset}

                        </div>

                         {/if}
                        {/snippet}





                    </div>
                </div>
            </div>


        </div>
<div class="col-xl-9 col-sm-12">
        <div class="row">
            <div class="col-xl-12 col-md-12 topic bg-light rounded-2 bg-300 p-2">
                {$azylProfil->getDescription()|noescape}
            </div>


        </div>
    <hr>
<div class="row">
        <div class="col-xl-5 col-md-12 news">

            <h3>Aktuality</h3>
            <div class="news" id="news">
                {foreach $azylNews as $new}

                {if $new->getImportant() === true}
                <div class = "card news-card text-dark bg-warning">
                    {else}
                    <div class = "card news-card text-dark bg-light">
                        {/if}
                        <h5 class="card-header">{$new->getTitle()}</h5>
                        <div class="card-body">
                            <p class="card-text"> {$new->getContent()|noescape}</p>
                            <p class="author-name card-text"><small class="text-muted">Vytvořeno: {$new->getCreatedAt()->format('d.m.Y. H:m:s')}</small></p>

                        </div>
                    </div>
                    {/foreach}
                    {if $azylNews != null}
                    <a n:href = "Home:azylnews $azyl->id" class="btn btn-sm btn-outline-primary">Více novinek...</a>
                    {else}
                    <p>Žádné novinky</p>
                    {/if}
                </div>


        </div>
        <div class="col-xl-7 col-md-12 adoptions">
            <h3>Adopce</h3>
            <div class="adoptions d-flex flex-row flex-wrap" id="adoptions">

                {foreach $adoptions as $adoption}
                    <div class="adoptions-border">
                        <div class = "card adoptions-card" style="width: 15rem;">
                            {if !is_null($adoption->getPhotos()[0])}
                                <img class="card-img-top" src="{$basePath}{$adoption->getPhotos()[0]->getPath().$adoption->getPhotos()[0]->getName()}" alt="{$adoption->getPhotos()[0]->getName()}" />
                            {else}
                                <img class="card-img-top" src="{$basePath}/assets/vazdata/img/pic/love1.jpeg" alt="Happy dino" />
                            {/if}
                            <h5 class="card-header">{$adoption->getName()}</h5>
                            <div class="card-body">
                                <div class="
                                                {switch $adoption->getAdoptionType()}
                                                {case 'Virtuální adopce'} bg-adopce-1
                                                {case 'Dočasná péče'} bg-adopce-2
                                                {case 'Předadopce'} bg-adopce-3
                                                {case 'Plná adopce'} bg-adopce-4
                                                {default} bg-default
                                                {/switch}
                                                large p-1 border-2 bold rounded-1">

                                    {$adoption->getAdoptionType()}
                                </div>
                                {if !is_null($adoption->getBirthdate())}
                                    {var $now = new DateTimeImmutable()}
                                    {var $interval = date_diff($vek = $adoption->getBirthdate(), $now)}

                                    <h5 class="card-title">Plemeno: {$adoption->getBreed()} Věk: {$interval->y} </h5>
                                {else}
                                    <h5 class="card-title">Plemeno: {$adoption->getBreed()}</h5>
                                {/if}
                                <p class="card-text">{$adoption->getDescription()}</p>
                                {if $user->isLoggedIn()}
                                <a href="{link Home:adopce $adoption->getId()}" class="btn btn-sm btn-outline-primary">Chci adoptovat!</a>
                                {else}
                                <a href="{link Home:SignIn}" class="btn btn-sm btn-outline-primary">Přihlášení</a>
                                {/if}
                            </div>
                        </div>
                    </div>
                {/foreach}
            </div>

        </div>

        </div>


    </div>
</div>

{/block}
{block scripts-user}
{/block}