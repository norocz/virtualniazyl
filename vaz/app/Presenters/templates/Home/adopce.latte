{block content}
<style>
    .azyl-card {

        margin: 1rem;

    }
    .autohor-name { background-color: #9da9bb}

    /* První obrázek větší než ostatní */
    .gallery-item.large {
        grid-row: span 2;
    }

    /* Styly pro ikonu mazání */
    .delete-icon {
        position: absolute;
        top: 5px;
        right: 5px;
        background-color: rgba(0, 0, 0, 0.7);
        color: #fff;
        padding: 5px;
        border-radius: 50%;
        cursor: pointer;
    }

    /* Modal pro zobrazení obrázku */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.95); /* Tmavé, téměř černé pozadí */
        overflow: hidden;
        align-items: center;
        justify-content: center;
    }

    .modal-content {
        max-width: 70vw; /* Max 80 % šířky okna */
        max-height: 70vh; /* Max 80 % výšky okna */
        object-fit: contain; /* Zachová poměr stran */
        background-color: black; /* Nastaví tmavé pozadí přímo na obrázek */
    }

    .close {
        position: absolute;
        bottom: 20px; /* Umístění do pravého dolního rohu */
        right: 20px;
        color: white;
        font-size: 30px;
        cursor: pointer;
        background-color: rgba(0, 0, 0, 0.6);
        padding: 5px 10px;
        border-radius: 5px;
    }


</style>

<main class="main" id="top">
    <div class="bg">
        <div class="content">
            <div class="row">
                <h2>Info o adopci</h2>
                <div class="col-xl-4 col-sm-12 flex-column">
                    <h4>Azyl</h4>
                    <div class="adopce" id="adopce">


                        <div class="card azyl-card text-dark bg-light">
                            <h5 class="card-header">{$adopce->getAzyl()->getAzylName()}</h5>
                            <div class="card-body">
                                <p class="card-text">{$adopce->getAzyl()->getDescription()|noescape}</p>
                                {if $adopce->getHowMuch() > 1 && $adopce->getMultiAdoption() == true}
                                {var $multiAdopce = true}
                                {else}
                                {var $multiAdopce = false}
                                {/if}

                                <a href="{link Home:azyl $adopce->getAzyl()->getId()}" class="btn btn-outline-primary btn-sm">Stránka azylu</a>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="col-xl-8 col-sm-12 flex-column">
                    <div class="animal-info">
                        {var $now = new DateTimeImmutable()}
                                        {var $interval = date_diff($vek = $adopce->getBirthdate(), $now)}
                      <h3>  {$adopce->getSpecies()->getName()} jménem {$adopce->getName()}</h3>
                        <h5>Věk: {$interval->y}, plemeno: {$adopce->getBreed()}</h5>
                        <p>{$adopce->getDescription()|noescape}</p>
                        {if $multiAdopce}
                        <p class = "bg-warning p-1">Pozor je tu možnost adoptovat více zvířat najednou (například nenarozená štěňátka). Počet míst ve Vašem srdci můžete nastavit níže.</p>
                        {/if}
                    </div>

                    {if $adopce->getPhotos() != null }
                        <div class="gallery row g-1">
                        {foreach $adopce->getPhotos() as $photo}
                            {if $iterator->first}
                                <div class="col-8 col-md-4 gallery-item large">
                                    <div class="position-relative">
                                        <img src="{$photo->getPath()}{$photo->getName()}" alt="{$photo->getOriginalName()}" class="img-fluid rounded" onclick="showImageModal(this.src)">
                                    </div>
                                </div>
                            {else}
                                <div class="col-4 col-md-2 gallery-item">
                                    <div class="position-relative">
                                        <img src="{$photo->getPath()}{$photo->getName()}" alt="{$photo->getOriginalName()}" class="img-fluid rounded" onclick="showImageModal(this.src)">
                                    </div>
                                </div>
                            {/if}
                        {/foreach}
                        </div>
                    {/if}
                </div>

                <div class="adoption-form col-xl-12 col-sm-12 flex-column">
                 {if $status != true && $user->isLoggedIn() && !$adopce->isAdopted()}

                    <form n:name=adoptionForm class=form>
                       <div class="row">
                       <div class="col-xl-10 col-sm-12">
                           <div class="form-group">
                               <label n:name="description">Napište o sobě něco:</label>
                               <textarea n:name="description" rows="5" cols="40" class="form-control form-textarea"></textarea>
                               <div class="invalid-feedback">{$form['description']->getOption('error')}</div>


                           </div>
                       </div>
                           <div class="col-xl-2 col-sm-12">
                           <div class="form-group">
                            {if $multiAdopce}
                           <label n:name="howMuch">Kolik chcete adoptovat zvířatek:</label>
                           <input n:name="howMuch" type="number" max="{$adopce->getHowMuch()}" min="1" value="1">
                               {/if}
                       </div>
                       </div>
                        <div class="row">
                            <div class="col-xl-12 col-sm-12">
                         <div class="form-group">
                            <input n:name="info" class="checkbox form-inline">
                            <label n:name="info">Souhlas s prověřením informací <a href="{link page:provereni}">(detaily)</a></label>

                            <div class="invalid-feedback">{$form['info']->getOption('error')}</div>
                        </div>

                        <div class="form-group">
                            <input n:name="souhlas" class="checkbox form-inline">
                            <label n:name="souhlas">Souhlas se zpracováním údajů <a href="{link page:souhlas}">(detaily)</a></label>

                            <div class="invalid-feedback">{$form['souhlas']->getOption('error')}</div>
                        </div>


                       </div>
                           <div class="col-xl-12 col-sm-12">
                        <div class="form-group">
                            <button n:name="sendAdoption" class="btn btn-outline-primary ajax">Nabídnout domov 🥹</button>
                        </div>
                       </div>

                   </form>
                    {elseif $status == true}

                    <div class="adopce-message alert alert-success align-center">

                        <span class="big-message"><h3>Tady už jste požádali o adopci!</h3> Zkuste jiné <a href="{link home:adoptions}">zvířátko</a>! Díky!</span>

                    </div>

                    {elseif $adopce->isAdopted()}
                    <div class="adopce-message alert alert-primary align-center">

                        <span class="big-message"><h3>Zvířátko je už adoptované!</h3> Zkuste jiné <a href="{link home:adoptions}">zvířátko</a>! Díky!</span>

                    </div>

                    {elseif !$user->isLoggedIn()}

                    <div class="adopce-message alert alert-secondary align-center">


                        <span class="big-message"><h3>Nejste přihlášený!</h3> <a class="btn btn-outline-success" href="{link home:signIn}">Přihlaste se</a> nebo se <a class="btn btn-outline-secondary" href="{link home:registration}">registrujte</a> a pak se přihlaste. Díky!</span>

                    </div>
                    {/if}
                </div>
            </div>






                </div>
            </div>
        </main>

        <!-- Modal pro zvětšení obrázku -->
<div id="imageModal" class="modal">
  <span class="close" onclick="closeModal()">×</span>
  <img class="modal-content" id="modalImage">
</div>
        {/block}
        {block scripts-user}
    <script>
        function showImageModal(src) {
          const modal = document.getElementById("imageModal");
          const modalImg = document.getElementById("modalImage");
          modal.style.display = "flex";
          modalImg.src = src;
        }

        function closeModal() {
          document.getElementById("imageModal").style.display = "none";
        }

      document.getElementById("imageModal").addEventListener('click', closeModal);
    </script>
        {/block}