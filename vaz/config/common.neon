parameters:
    payments:
        account: '123456789/0100'

application:
	errorPresenter: Error
	mapping:
		*: App\*Module\Presenters\*Presenter

latte:
	strictTypes: yes

session:
	expiration: 14 days
	autoStart: true
	cookieSecure: true
	cookieSamesite: 'Lax'
	cookieHttponly: true

di:
	export:
		parameters: no
		tags: no